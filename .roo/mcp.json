{
	"mcpServers": {
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"headers": {
				"Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
			},
			"alwaysAllow": [
				"get_file_contents"
			]
		},
		"brave-search": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-brave-search"
			],
			"env": {
				"BRAVE_API_KEY": "${BRAVE_API_KEY}"
			},
			"alwaysAllow": [
				"brave_web_search"
			]
		}
	}
}